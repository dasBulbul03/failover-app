# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug & audit logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Terraform: Never commit actual variable files with secrets
# Keep only *.tfvars.example files
*.tfvars
!*.tfvars.example

# Terraform state files (always use remote state)
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Failover state/lock files
/tmp/failover_orchestrator.lock
failover_state.json

# local env files
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
