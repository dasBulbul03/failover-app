# ==============================================================================
# S3 & DynamoDB Remote State Backend Template
# Store Terraform state centrally with distributed locking
# ==============================================================================

# To activate remote state:
# 1. Create the S3 bucket with versioning and SSE enabled:
#    aws s3api create-bucket --bucket failover-app-tfstate-<account-id> --region ap-southeast-2 \
#      --create-bucket-configuration LocationConstraint=ap-southeast-2
# 2. Create DynamoDB locking table:
#    aws dynamodb create-table --table-name failover-app-tflock \
#      --attribute-definitions AttributeName=LockID,AttributeType=S \
#      --key-schema AttributeName=LockID,KeyType=HASH \
#      --billing-mode PAY_PER_REQUEST --region ap-southeast-2
# 3. Rename this file to backend.tf and run: terraform init -migrate-state

# terraform {
#   backend "s3" {
#     bucket         = "failover-app-tfstate-REPLACE_ACCOUNT_ID"
#     key            = "disaster-recovery/aws/terraform.tfstate"
#     region         = "ap-southeast-2"
#     dynamodb_table = "failover-app-tflock"
#     encrypt        = true
#   }
# }
